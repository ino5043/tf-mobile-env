<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS だけを許し、OS に入っている証明書だけを信頼する（利用者が足した証明書は信頼しない） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
